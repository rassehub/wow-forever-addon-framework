#!/usr/bin/env python3
"""fk - ForeverKit command line. Python 3 standard library only.

Run `tools/fk <command> -h` for details of a command.
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
LUA = ROOT / ".tools" / "lua"
CONFIG = ROOT / ".fk.local.json"
HARNESS = ROOT / "harness"


def die(msg):
    sys.exit(f"fk: {msg}")


def load_config():
    return json.loads(CONFIG.read_text()) if CONFIG.exists() else {}


def wow_dir(required=True):
    """The _forever_ directory of the WoW install, from $FK_WOW_DIR or .fk.local.json."""
    path = os.environ.get("FK_WOW_DIR") or load_config().get("wow_dir")
    if path and (Path(path) / "Interface").is_dir():
        return Path(path)
    if required:
        die("WoW directory not set. Run: tools/fk doctor --wow '/path/to/World of Warcraft/_forever_'")
    return None


def lua(*args, check=True, capture=False):
    if not LUA.exists():
        die("Lua is not built yet. Run: tools/setup.sh")
    env = dict(os.environ, LUA_PATH=f"{HARNESS}/?.lua;{HARNESS}/?/init.lua", FK_ROOT=str(ROOT))
    result = subprocess.run([str(LUA), *map(str, args)], cwd=ROOT, env=env,
                            capture_output=capture, text=True)
    if check and result.returncode != 0:
        if capture:
            sys.stderr.write(result.stdout + result.stderr)
        sys.exit(result.returncode)
    return result


def cmd_doctor(args):
    if args.wow:
        path = Path(args.wow).expanduser().resolve()
        if not (path / "Interface").is_dir():
            die(f"{path} has no Interface folder; point at the _forever_ directory")
        CONFIG.write_text(json.dumps(dict(load_config(), wow_dir=str(path)), indent=2) + "\n")
    ok = True

    def report(good, label, detail):
        nonlocal ok
        ok = ok and good
        print(f"  [{'ok' if good else '!!'}] {label}: {detail}")

    report(LUA.exists(), "Lua 5.1", LUA if LUA.exists() else "missing, run tools/setup.sh")
    wow = wow_dir(required=False)
    report(wow is not None, "WoW Forever", wow or "not set (only needed for `fk link`, `fk live`, `fk data`)")
    if wow:
        addons = wow / "Interface" / "AddOns"
        names = sorted(p.name for p in addons.iterdir() if p.is_dir())
        report(True, "AddOns", f"{len(names)} installed")
        accounts = [p for p in (wow / "WTF" / "Account").glob("*") if p.is_dir() and p.name != "SavedVariables"]
        # the account folder name is private: report the count only
        report(bool(accounts), "WTF accounts", f"{len(accounts)} found")
    sys.exit(0 if ok else 1)


def test_files(paths):
    if paths:
        found = []
        for p in map(Path, paths):
            found += sorted(p.rglob("*.lua")) if p.is_dir() else [p]
        return found
    return sorted(ROOT.glob("tests/*.lua")) + sorted(ROOT.glob("examples/*/tests/*.lua"))


def cmd_test(args):
    """One Lua process per test file, so files cannot affect each other."""
    files = test_files(args.paths)
    if not files:
        die("no test files found")
    failed = 0
    for f in files:
        extra = ["--verbose"] if args.verbose else []
        result = lua(HARNESS / "run.lua", *extra, f, check=False, capture=True)
        out = (result.stdout + result.stderr).strip()
        rel = os.path.relpath(f, ROOT)
        if result.returncode != 0:
            failed += 1
            print(f"{rel}\n{out}")
        else:
            print(f"{rel}: {out.splitlines()[-1]}" if not args.verbose else f"{rel}\n{out}")
    if not args.paths:
        # shell tests of the tooling itself
        for script in sorted(ROOT.glob("tests/*.sh")):
            result = subprocess.run([str(script)], capture_output=True, text=True)
            print((result.stdout + result.stderr).strip())
            failed += result.returncode != 0
    sys.exit(1 if failed else 0)


def addon_dir(arg):
    """An addon folder: a path, or a name looked up in examples/ and addons/."""
    for candidate in (Path(arg), ROOT / "examples" / arg, ROOT / "addons" / arg):
        if candidate.is_dir():
            return candidate.resolve()
    die(f"addon folder not found: {arg}")


def harness_args(args):
    out = []
    for snippet in args.do or []:
        out += ["--do", snippet]
    if args.theme:
        out += ["--theme", args.theme]
    wow = wow_dir(required=False)
    if wow:
        out += ["--addons-path", wow / "Interface" / "AddOns"]
    return out


def cmd_tree(args):
    extra = ["--textures"] if args.textures else []
    result = lua(HARNESS / "cli.lua", "tree", addon_dir(args.addon), *harness_args(args), *extra, check=False)
    sys.exit(result.returncode)


# Static lint rules: (code, level, regex, message). Applied per line, comments stripped.
LINT_RULES = [
    ("deprecated-api", "error", r"(?<![\w.:])(GetItemInfo|GetItemInfoInstant|GetItemCount|GetItemIcon|GetContainerItemInfo|GetContainerNumSlots|GetContainerItemLink|GetAddOnMetadata|IsAddOnLoaded|GetSpellInfo|GetSpellTexture|SendAddonMessage|RegisterAddonMessagePrefix|InterfaceOptions_AddCategory|InterfaceOptionsFrame_OpenToCategory)\s*\(",
     "{0} was removed from the modern client; use its C_* namespace (C_Item, C_Container, C_AddOns, C_Spell, C_ChatInfo) or Settings.*"),
    ("legacy-dropdown", "error", r"\bUIDropDownMenu_\w+", "UIDropDownMenu is legacy; use FK.Dropdown / FK.Menu"),
    ("blizzard-template", "warning", r"CreateFrame\([^)]*,[^)]*,[^)]*,\s*\"(?!BackdropTemplate\"|Secure)([^\"]+)\"",
     "Blizzard template {0}: ForeverKit widgets are built from primitives so themes and the emulator cover them; use an FK widget"),
    ("secret-compute", "error", r"\b(UnitHealth|UnitHealthMax|UnitPower|UnitPowerMax)\s*\([^)]*\)\s*(==|~=|<=|>=|<|>|\+|-|\*|/|%)",
     "{0}() returns a secret value in combat: comparing or computing with it raises an error. Pass it straight to a StatusBar/FontString (FK.ProgressBar), or guard with issecretvalue()"),
    ("secret-compute", "error", r"(==|~=|<=|>=|<|>|\+|\*|/)\s*(UnitHealth|UnitHealthMax|UnitPower|UnitPowerMax)\s*\(",
     "{1}() returns a secret value in combat: comparing or computing with it raises an error"),
    ("hardcoded-font", "warning", r":SetFont\(\s*\"", "hard-coded font file breaks Cyrillic/CJK clients: use FK.Theme.Font or take the file from a font object's GetFont()"),
    ("global-function", "warning", r"^function\s+[A-Za-z_]\w*\s*\(", "global function: declare it local or on the addon namespace"),
    ("getglobal", "error", r"\b(getglobal|setglobal)\s*\(", "{0} no longer exists; use _G[name]"),
    ("combat-settings", "warning", r"Settings\.OpenToCategory", "Settings.OpenToCategory is blocked in combat; open the addon's own options window (options:Open())"),
]
ENUM_ITEMS = re.compile(r"items\s*=\s*\{([^{}]*)\}")
NUMERIC_LABEL = re.compile(r"^\s*-?\d[\d.,]*\s*(.*?)\s*$")


def lint_static(addon):
    """Yields (path, line, level, code, message)."""
    name = addon.name
    tocs = sorted(addon.glob("*.toc"))
    if not tocs:
        yield addon, 0, "error", "toc-missing", f"no .toc file in {addon}"
        return
    toc = next((t for t in tocs if t.stem in (name, name + "_Forever", name + "_Camelot")), None)
    if toc is None:
        yield tocs[0], 0, "error", "toc-name", f"the TOC must be named {name}.toc (the folder's name)"
        toc = tocs[0]
    meta, listed = {}, []
    for n, line in enumerate(toc.read_text(encoding="utf-8-sig").splitlines(), 1):
        m = re.match(r"##\s*([^:]+?)\s*:\s*(.*?)\s*$", line)
        if m:
            meta[m.group(1)] = m.group(2)
        elif line.strip() and not line.lstrip().startswith("#"):
            rel = re.sub(r"\s*\[.*\]\s*$", "", line.strip()).replace("\\", "/")
            listed.append(rel)
            if not (addon / rel).exists():
                yield toc, n, "error", "toc-file-missing", f"{rel} is listed but does not exist (check upper/lower case: the game is case-insensitive, your tests are not)"
    if "16001" not in meta.get("Interface", ""):
        yield toc, 1, "error", "toc-interface", "## Interface must include 16001 for WoW Forever"
    for field in ("Title", "Notes", "Version"):
        if field not in meta:
            yield toc, 1, "warning", "toc-field", f"## {field} is missing"
    saved = set(re.split(r"[,\s]+", meta.get("SavedVariables", "") + "," + meta.get("SavedVariablesPerCharacter", ""))) - {""}

    sources = sorted(p for p in addon.rglob("*.lua") if "Libs" not in p.relative_to(addon).parts and "tests" not in p.relative_to(addon).parts)
    listed_lower = {x.lower() for x in listed}
    for path in sources:
        rel = path.relative_to(addon).as_posix()
        if rel.lower() not in listed_lower and not any(x.lower().endswith(".xml") for x in listed):
            yield path, 0, "warning", "toc-unlisted", f"{rel} is not listed in the TOC, so the game never loads it"
        text = path.read_text(encoding="utf-8-sig")
        for m in re.finditer(r"NewDB\(\s*\"(\w+)\"", text):
            if m.group(1) not in saved:
                yield path, text.count("\n", 0, m.start()) + 1, "error", "savedvariable-undeclared", f"{m.group(1)} is used by FK:NewDB but not declared in ## SavedVariables: settings would be lost on logout"
        for m in ENUM_ITEMS.finditer(text):
            labels = re.findall(r"\"([^\"]*)\"|(?<![\w.])(-?\d[\d.]*)(?![\w.])", m.group(1))
            labels = [a or b for a, b in labels]
            units = [NUMERIC_LABEL.match(x) for x in labels]
            if len(labels) >= 3 and all(units) and len({u.group(1) for u in units}) == 1:
                yield path, text.count("\n", 0, m.start()) + 1, "error", "ui-enum-should-be-slider", f"a choice between preset numbers ({labels[0]} ... {labels[-1]}): use a slider (type = \"slider\" / FK.Slider) with min, max and step"
        for n, line in enumerate(text.splitlines(), 1):
            code = re.sub(r"--.*$", "", line)
            for rule, level, pattern, message in LINT_RULES:
                m = re.search(pattern, code)
                if m:
                    yield path, n, level, rule, message.format(*[g or "" for g in m.groups()])


def cmd_lint(args):
    addon = addon_dir(args.addon)
    findings = list(lint_static(addon))
    wow = wow_dir(required=False)
    extra = ["--addons-path", wow / "Interface" / "AddOns"] if wow else []
    result = lua(HARNESS / "cli.lua", "lint", addon, *extra, check=False, capture=True)
    if result.returncode != 0:
        findings.append((addon, 0, "error", "load-error", (result.stderr or result.stdout).strip().splitlines()[0] if (result.stderr or result.stdout).strip() else "the addon failed to load in the emulator"))
    for line in result.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) == 3:
            findings.append((addon, 0, parts[0], parts[1], parts[2]))
    errors = 0
    for path, line, level, code, message in findings:
        errors += level == "error"
        where = os.path.relpath(path, ROOT) + (f":{line}" if line else "")
        print(f"{where}: {level} [{code}] {message}")
    print(f"{len(findings)} finding(s), {errors} error(s)")
    sys.exit(1 if errors else 0)


def screenshot(html, png, width, height):
    """PNG of an HTML file with headless Firefox (own throwaway profile, so a running Firefox is not disturbed)."""
    firefox = shutil.which("firefox")
    if not firefox:
        die("firefox not found: open the HTML file in a browser instead")
    with tempfile.TemporaryDirectory() as profile:
        subprocess.run([firefox, "--headless", "--no-remote", "--profile", profile,
                        f"--window-size={width},{height}", "--screenshot", str(png), html.as_uri()],
                       check=True, capture_output=True, timeout=120)


def cmd_preview(args):
    addon = addon_dir(args.addon)
    out_dir = ROOT / ".preview"
    out_dir.mkdir(exist_ok=True)
    themes = args.theme.split(",") if args.theme else [None]
    for theme in themes:
        stem = addon.name + (f"-{theme}" if theme else "") + (f"-{args.name}" if args.name else "")
        html = out_dir / f"{stem}.html"
        args.theme = theme
        lua(HARNESS / "cli.lua", "html", addon, *harness_args(args), "--out", html, *(["--full"] if args.full else []))
        print(html)
        if not args.no_png:
            m = re.search(r"#screen\{position:relative;width:(\d+)px;height:(\d+)px", html.read_text())
            png = html.with_suffix(".png")
            screenshot(html, png, int(m.group(1)), int(m.group(2)))
            print(png)


def cmd_data(args):
    """Look up items, NPCs, objects and quests in the installed QuestieDB (through the emulator)."""
    db = Path(args.questiedb) if args.questiedb else None
    if not db:
        wow = wow_dir()
        db = wow / "Interface" / "AddOns" / "QuestieDB"
    if not db.is_dir():
        die(f"QuestieDB not found at {db}: install it, or pass --questiedb DIR")
    extra = (["--json"] if args.json else []) + (["--raw"] if args.raw else []) + (["--fields", args.fields] if args.fields else [])
    lua(HARNESS / "data.lua", db, args.entity, " ".join(args.query), *extra)


FKDEV = ROOT / "tools" / "FKDev"


def addons_folder():
    path = wow_dir() / "Interface" / "AddOns"
    if not path.is_dir():
        die(f"no AddOns folder at {path}")
    return path


def cmd_link(args):
    """Symlink addon folders from this repo into the game's AddOns folder (nothing is copied)."""
    target_dir = addons_folder()
    for name in args.addons:
        src = FKDEV if name == "FKDev" else addon_dir(name)
        dst = target_dir / src.name
        if dst.is_symlink():
            if dst.resolve() == src.resolve():
                print(f"{src.name}: already linked")
                continue
            die(f"{dst} is a symlink to {os.readlink(dst)}, not this repo; leaving it alone")
        if dst.exists():
            die(f"{dst} already exists and is not a link (an installed addon?); leaving it alone")
        dst.symlink_to(src.resolve(), target_is_directory=True)
        print(f"{src.name}: linked -> {src.resolve()}")
    print("A newly linked addon appears after restarting the game (a /reload does not rescan the folder list).")


def cmd_unlink(args):
    """Remove symlinks made by `fk link`. Only symlinks into this repo are touched, never real folders."""
    target_dir = addons_folder()
    for name in args.addons:
        dst = target_dir / name
        if not dst.is_symlink():
            die(f"{dst} is not a symlink; fk only removes its own links")
        if ROOT.resolve() not in dst.resolve().parents:
            die(f"{dst} points outside this repo ({os.readlink(dst)}); leaving it alone")
        dst.unlink()
        print(f"{name}: unlinked")


def fkdev_saved():
    """The newest FKDev.lua SavedVariables file under WTF/Account (the account folder name is never printed)."""
    files = sorted((wow_dir() / "WTF" / "Account").glob("*/SavedVariables/FKDev.lua"), key=lambda p: p.stat().st_mtime)
    if not files:
        die("no FKDev results yet: link FKDev (fk link FKDev), restart the game, log in, then /reload")
    out = lua(HARNESS / "sv2json.lua", files[-1], capture=True)
    data = json.loads(out.stdout).get("FKDevDB") or {}
    return data, files[-1]


def cmd_live(args):
    if args.action == "run":
        snippets = args.lua or []
        qid = time.strftime("%Y%m%d-%H%M%S")
        def q(v):
            return "[==[" + v + "]==]"
        body = ["-- Written by `fk live run`; runs once, after the next /reload.", "FKDEV_QUEUE = {",
                f"\tid = {q(qid)},", "\tlua = {"] + [f"\t\t{q(code)}," for code in snippets] + ["\t},"]
        if args.tree:
            body.append(f"\ttree = {q(args.tree)},")
        if args.shot:
            body.append("\tshot = true,")
        body.append("}")
        if any("]==]" in code for code in snippets + [args.tree or ""]):
            die("a snippet contains ]==]; rephrase it")
        (FKDEV / "Queue.lua").write_text("\n".join(body) + "\n")
        print(f"queued {qid}. In game: /reload (or /rl), then click the FKDev button to save, then: fk live results")
        return
    if args.action == "shot":
        shots = sorted((wow_dir() / "Screenshots").glob("*"), key=lambda p: p.stat().st_mtime)
        if not shots:
            die("no screenshots yet")
        print(shots[-1])
        return
    data, path = fkdev_saved()
    sessions = data.get("sessions") or []
    if not sessions:
        die("FKDevDB has no sessions yet")
    s = sessions[0]
    age = int(time.time() - path.stat().st_mtime)
    print(f"session {s.get('started')} (saved {age}s ago), client {', '.join(map(str, s.get('client', [])))}")
    errors = s.get("errors") or []
    if args.action == "errors" or errors:
        print(f"\n{len(errors)} error(s):")
        for e in errors:
            print(f"  [{e.get('kind')}] x{e.get('count')} {e.get('message')}")
            if args.verbose and e.get("stack"):
                print("    " + str(e["stack"]).replace("\n", "\n    "))
    if args.action == "errors":
        return
    tests = s.get("tests") or []
    failed = [t for t in tests if not t.get("ok")]
    print(f"\n{len(tests) - len(failed)} test(s) passed, {len(failed)} failed")
    for t in tests:
        if t.get("ok") and not args.verbose:
            continue
        print(f"  {'ok  ' if t.get('ok') else 'FAIL'} {t.get('addon')}: {t.get('name')}")
        for f in t.get("failures") or []:
            print("       " + str(f).replace("\n", "\n       "))
    run = s.get("run")
    if run:
        print(f"\nqueue {run.get('id')}:")
        for o in run.get("outputs") or []:
            status = "ok" if o.get("ok") else "ERROR"
            print(f"  {status} {o.get('code')}")
            if o.get("error"):
                print(f"       {o['error']}")
            if o.get("returns"):
                print("       -> " + ", ".join(map(str, o["returns"])))
        for line in run.get("tree") or []:
            print("  " + line)
    if failed or errors:
        sys.exit(1)


def main():
    parser = argparse.ArgumentParser(prog="fk", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("doctor", help="check the toolchain and local configuration")
    p.add_argument("--wow", help="set the path of the _forever_ directory")
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser("test", help="run emulator tests (default: tests/ and examples/*/tests/)")
    p.add_argument("paths", nargs="*", help="test files or directories")
    p.add_argument("-v", "--verbose", action="store_true", help="list passing tests and chat output")
    p.set_defaults(func=cmd_test)

    def ui_args(p):
        p.add_argument("addon", help="addon folder, or the name of one in examples/ or addons/")
        p.add_argument("--do", action="append", metavar="LUA",
                       help="Lua to run after login, e.g. --do 'H.Slash(\"/myaddon\")' (sees H, ns, FK; repeatable)")
        p.add_argument("--theme", help="ForeverKit theme to apply (preview: comma-separated list for one image each)")

    p = sub.add_parser("tree", help="print the visible frame tree of an addon and its layout issues")
    ui_args(p)
    p.add_argument("--textures", action="store_true", help="also list textures")
    p.set_defaults(func=cmd_tree)

    p = sub.add_parser("lint", help="check an addon: TOC, removed APIs, secret-value misuse, UI rules, global leaks, layout")
    p.add_argument("addon", help="addon folder, or the name of one in examples/ or addons/")
    p.set_defaults(func=cmd_lint)

    p = sub.add_parser("data", help="look up QuestieDB data offline: fk data item \"Linen Cloth\"")
    p.add_argument("entity", choices=["item", "npc", "object", "quest"])
    p.add_argument("query", nargs="+", help="id, or exact name")
    p.add_argument("--json", action="store_true", help="JSON instead of Lua-style output")
    p.add_argument("--fields", help="comma-separated fields to show (default: all)")
    p.add_argument("--raw", action="store_true", help="plain ids in drop/vendor/quest lists, without names")
    p.add_argument("--questiedb", help="QuestieDB folder (default: the one in the configured WoW install)")
    p.set_defaults(func=cmd_data)

    p = sub.add_parser("link", help="symlink addons (examples/, addons/, or FKDev) into the game's AddOns folder")
    p.add_argument("addons", nargs="+")
    p.set_defaults(func=cmd_link)

    p = sub.add_parser("unlink", help="remove symlinks made by fk link")
    p.add_argument("addons", nargs="+")
    p.set_defaults(func=cmd_unlink)

    p = sub.add_parser("live", help="live loop with the real client through FKDev: run | results | errors | shot")
    p.add_argument("action", choices=["run", "results", "errors", "shot"])
    p.add_argument("--lua", action="append", help="(run) Lua to run in game after the next /reload; repeatable")
    p.add_argument("--tree", help="(run) frame name to dump after the queue ran")
    p.add_argument("--shot", action="store_true", help="(run) take a screenshot after the queue ran")
    p.add_argument("-v", "--verbose", action="store_true", help="(results) list passing tests and error stacks")
    p.set_defaults(func=cmd_live)

    p = sub.add_parser("preview", help="render an addon's UI to .preview/<name>.html and .png")
    ui_args(p)
    p.add_argument("--full", action="store_true", help="whole screen instead of the largest window")
    p.add_argument("--name", help="suffix for the output file name")
    p.add_argument("--no-png", action="store_true", help="HTML only")
    p.set_defaults(func=cmd_preview)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
